{
  "schema_version": 2,
  "runtime": {
    "php": "^8.5",
    "laravel": "^13.0",
    "database": "postgresql-18",
    "release_database": "pgsql",
    "database_major": 18,
    "database_minor_policy": "latest-supported-18.x",
    "canonical_verification": "docker-compose-v2"
  },
  "policies": {
    "laravel_native_first": true,
    "mature_documented_package_before_custom_infrastructure": true,
    "replacement_requires_retirement_plan": true,
    "continuous_optimization_per_tranche": true,
    "new_packages_require_registry_entry": true,
    "new_stage_errors_may_enter_phpstan_baseline": false,
    "vendor_derived_code_must_pass_project_gates": true,
    "unit_tests_boot_laravel_application": false,
    "release_database_major_exact": 18,
    "package_schema_contract_required_for_package_owned_tables": true,
    "database_feature_tests_require_explicit_isolation": true,
    "release_candidates_require_lockfiles": true,
    "normal_release_apply_may_update_dependencies": false,
    "canonical_full_postgres_suite_starts_clean": true,
    "repository_authorities_resolve_through_compiler": true,
    "raw_authority_literals_outside_allowlist": false,
    "canonical_verification_precedes_release_packaging": true,
    "artifact_provenance_matches_canonical_tree": true,
    "verification_topology_has_single_stage_and_canonical_owner": true,
    "installer_delegates_to_verification_entrypoint": true,
    "model_specific_ai_docs_are_thin_bootstraps": true,
    "ai_workflow_has_single_protocol_authority": true,
    "linux_wsl2_docker_is_primary_development_runtime": true,
    "codespaces_is_remote_development_adapter": true,
    "native_windows_execution_is_retired": true,
    "laragon_is_retired": true,
    "host_language_toolchains_not_required_for_primary_development": true,
    "verification_public_command_surface_is_bounded": true,
    "legacy_verification_aliases_must_remain_removed": true
  },
  "packages": {
    "composer/semver": {"constraint": "^3.4", "status": "required", "capability_owner": "version-tooling", "purpose": "Version constraint evaluation", "platforms": ["linux"], "review_required": true},
    "fakerphp/faker": {"constraint": "^1.24", "status": "required-dev", "capability_owner": "test-data", "purpose": "Factories and fixtures", "platforms": ["linux"], "review_required": true},
    "larastan/larastan": {"constraint": "^3.8", "status": "required-dev", "capability_owner": "static-analysis", "purpose": "Larastan/PHPStan integration", "platforms": ["linux"], "review_required": true},
    "laravel/fortify": {"constraint": "^1.30", "status": "required", "capability_owner": "authentication", "purpose": "Authentication and 2FA", "platforms": ["linux"], "review_required": true},
    "laravel/framework": {"constraint": "^13.0", "status": "required", "capability_owner": "framework", "purpose": "Application framework", "platforms": ["linux"], "review_required": true},
    "laravel/boost": {"constraint": "^2.7", "status": "required-dev", "capability_owner": "ai-framework-context", "purpose": "Laravel/package AI context and framework MCP tooling; must not replace SongChart project knowledge authority", "platforms": ["linux"], "review_required": true, "official_owner": "laravel"},
    "laravel/horizon": {"constraint": "^5.48", "status": "required", "capability_owner": "queue-runtime", "purpose": "Primary Redis queue supervision and operational visibility", "platforms": ["linux"], "review_required": true, "official_owner": "laravel"},
    "laravel/pail": {"constraint": "^1.2", "status": "required-dev", "capability_owner": "developer-tooling", "purpose": "Local log inspection", "platforms": ["linux"], "review_required": true},
    "laravel/pint": {"constraint": "^1.24", "status": "required-dev", "capability_owner": "formatting", "purpose": "PHP formatting", "platforms": ["linux"], "review_required": true},
    "laravel/pulse": {"constraint": "^1.7.4", "status": "required", "capability_owner": "observability", "purpose": "Operational observability", "platforms": ["linux"], "review_required": true, "official_owner": "laravel", "database_support": ["pgsql"], "published_assets": ["config/pulse.php", "database/migrations/*pulse*"], "adaptation_policy": "vendor-derived files must pass SongChart Pint/Larastan/Pest; fail-closed adaptations allowed"},
    "laravel/tinker": {"constraint": "^3.0", "status": "required", "capability_owner": "developer-tooling", "purpose": "Local application console", "platforms": ["linux"], "review_required": true},
    "livewire/livewire": {"constraint": "^4.0", "status": "required", "capability_owner": "interactive-ui", "purpose": "Server-driven interaction", "platforms": ["linux"], "review_required": true},
    "mockery/mockery": {"constraint": "^1.6", "status": "required-dev", "capability_owner": "testing", "purpose": "Test doubles", "platforms": ["linux"], "review_required": true},
    "nunomaduro/collision": {"constraint": "^8.8", "status": "required-dev", "capability_owner": "developer-experience", "purpose": "Console test output", "platforms": ["linux"], "review_required": true},
    "pestphp/pest": {"constraint": "^4.0", "status": "required-dev", "capability_owner": "testing", "purpose": "Test runner", "platforms": ["linux"], "review_required": true},
    "pestphp/pest-plugin-browser": {"constraint": "^4.3", "status": "required-dev", "capability_owner": "browser-testing", "purpose": "Playwright-backed desktop/mobile critical browser smoke with CI diagnostic evidence", "platforms": ["linux"], "review_required": true, "official_owner": "pestphp", "runtime_requirements": ["ext-sockets", "playwright", "chromium"]},
    "pestphp/pest-plugin-laravel": {"constraint": "^4.1", "status": "required-dev", "capability_owner": "testing", "purpose": "Laravel Pest integration", "platforms": ["linux"], "review_required": true},
    "spatie/laravel-activitylog": {"constraint": "^5.0", "status": "required", "capability_owner": "privileged-audit", "purpose": "Business audit trail for privileged operations", "platforms": ["linux"], "review_required": true, "official_owner": "spatie", "database_support": ["pgsql"], "usage_policy": "Explicit privileged/business events only; automatic broad model-event logging is forbidden."}
  },
  "planned_packages": {
    "saloonphp/laravel-plugin": {
      "decision": "defer-after-inventory",
      "capability_owner": "provider-http-transport",
      "purpose": "Provider connector/request/auth/retry/test plumbing",
      "decision_authority": "docs/project/stack/provider-transport-inventory.json",
      "reason": "Current provider transport surface is small and already uses Laravel Http; package adoption would not yet retire enough custom surface."
    },
    "spatie/laravel-data": {
      "decision": "defer-until-api-v1",
      "capability_owner": "cross-boundary-data",
      "purpose": "Typed data, validation and resource/API contract consolidation",
      "decision_authority": "docs/project/domain/typed-data-inventory.json",
      "reason": "No broad duplicate request/DTO/resource/TypeScript surface is proven yet."
    },
    "spatie/laravel-backup": {
      "decision": "adopt-in-19.0.5",
      "capability_owner": "backup-orchestration",
      "purpose": "Backup orchestration, retention and notification; restore drill remains SongChart release evidence"
    }
  },
  "deployment_profiles": {
    "linux-production": {"horizon": "primary-queue-supervisor", "queue": "laravel-redis-horizon", "pulse": "supported", "database": "external-postgresql-18-recommended", "redis": "external-recommended"},
    "linux-wsl2-development": {"horizon": "primary-queue-supervisor", "queue": "laravel-redis-horizon", "pulse": "supported"},
    "codespaces": {"horizon": "primary-queue-supervisor", "queue": "laravel-redis-horizon", "pulse": "supported"}
  },
  "external_tools": {
    "docker-engine-compose-v2": {"status": "primary-development-and-production-runtime", "purpose": "Linux/WSL2 development, production packaging and canonical verification", "platforms": ["linux", "wsl2"], "review_required": true},
    "github-codespaces": {"status": "remote-development-adapter", "purpose": "mobile/remote-accessible development adapter over the same repository/runtime contract", "platforms": ["cloud-linux"], "review_required": true},
    "caddy": {"version": "2.11.3", "status": "development-and-production-edge", "purpose": "HTTPS reverse proxy, TLS and static edge", "platforms": ["docker-linux"], "review_required": true},
    "mkcert": {"status": "host-development-only", "purpose": "locally trusted development certificate generation", "platforms": ["linux", "wsl2-host-integration"], "review_required": true, "private_key_must_not_be_committed": true}
  }
}
