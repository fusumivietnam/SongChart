{
  "schema_version": 3,
  "release_authority": {
    "php_major_minor": "8.5",
    "postgres_major": 18,
    "database": "pgsql"
  },
  "profiles": {
    "canonical-test": {
      "app_env": "testing",
      "db_connection": "pgsql",
      "db_host": "postgres",
      "db_database": "songchart_verify_test",
      "redis_host": "redis",
      "destructive_database_role": "testing",
      "authority": "release-verification",
      "compose_file": "compose.verify.yml"
    },
    "docker-development": {
      "app_env": "local",
      "db_connection": "pgsql",
      "db_host": "postgres",
      "db_database": "songchart_docker",
      "redis_host": "redis",
      "destructive_database_role": "development",
      "authority": "primary-development",
      "compose_file": "compose.dev.yml"
    },
    "docker-demo": {
      "app_env": "demo",
      "db_connection": "pgsql",
      "db_host": "postgres",
      "db_database": "songchart_docker",
      "redis_host": "redis",
      "destructive_database_role": "development",
      "authority": "public-live-verification-adapter",
      "compose_file": "compose.demo.yml",
      "shares_database_with": "docker-development",
      "queue_worker_default": false
    },
    "production": {
      "app_env": "production",
      "db_connection": "pgsql",
      "redis_required": true,
      "queue_connection": "redis",
      "cache_store": "redis",
      "worker_entrypoint": "sh scripts/production/queue-worker.sh",
      "scheduler_entrypoint": "sh scripts/production/scheduler.sh",
      "scheduler_instances": 1,
      "process_manager_restart_required": true,
      "authority": "first-release-production-runtime"
    }
  },
  "php_extensions": {
    "base_image": [
      "curl",
      "dom",
      "mbstring",
      "xml"
    ],
    "compiled": [
      "bcmath",
      "intl",
      "pcntl",
      "pdo_pgsql",
      "zip"
    ],
    "pecl": [
      "redis"
    ],
    "required": [
      "bcmath",
      "curl",
      "dom",
      "intl",
      "mbstring",
      "pcntl",
      "pdo_pgsql",
      "redis",
      "xml",
      "zip"
    ]
  },
  "primary_development_profile": "docker-development"
}
