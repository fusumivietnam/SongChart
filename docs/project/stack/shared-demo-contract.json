{
  "schema_version": 2,
  "status": "development-demo-adapter",
  "purpose": "Provide one production-like public demo surface without creating a second database or queue authority.",
  "database": {
    "engine": "postgresql",
    "ownership": "development-authority",
    "database": "songchart_docker",
    "destructive_reset_allowed": false,
    "canonical_verification_database_remains_isolated": true
  },
  "application": {
    "compose_file": "compose.demo.yml",
    "project": "songchart-demo",
    "host_port": 8001,
    "codespaces_visibility": "private-by-default",
    "https_owner_in_codespaces": "GitHub Codespaces port forwarding proxy",
    "auto_start": false,
    "services": ["redis", "app"],
    "runtime_image": "songchart/dev-runtime:local",
    "queue_owner": "single-shared-development-horizon-worker"
  },
  "secrets": {
    "runtime_file": ".env.demo",
    "committed": false,
    "default_passwords": false
  },
  "commands": {
    "canonical_entrypoint": "./songchart demo",
    "setup": "./songchart demo setup",
    "up": "./songchart demo up",
    "down": "./songchart demo down",
    "status": "./songchart demo status",
    "logs": "./songchart demo logs",
    "url": "./songchart demo url",
    "legacy_adapter": "./scripts/shared-demo.sh"
  },
  "safety": {
    "migrate_fresh_exposed": false,
    "generic_artisan_against_demo_exposed": false,
    "duplicate_queue_service_forbidden": true,
    "duplicate_database_authority_forbidden": true,
    "canonical_verification_database_remains_isolated": true
  },
  "compatibility": {
    "shared_demo_script": "thin-delegating-adapter",
    "legacy_migrate_and_seed_commands": "retired"
  }
}
