  "current_forward_migrations": [
    {
      "path": "database/migrations/2026_08_16_000100_add_attribute_changes_to_activity_log_if_missing.php",
      "purpose": "Add the Spatie v5 attribute_changes JSON column for databases where the historical create migration was already recorded before the column was introduced.",
      "idempotency": "Schema::hasTable + Schema::hasColumn guard",
      "rollback": "no-op; forward-only repair must not remove a column that may have pre-existed before this migration was recorded"
    }
  ],
  "upgrade_fixtures": {
    "activity_log_pre_attribute_changes": {
      "base_migration": "2026_08_13_000100_create_activity_log_table",
      "missing_column": "attribute_changes",
      "target_migration": "2026_08_16_000100_add_attribute_changes_to_activity_log_if_missing"
    }
  },
  "fingerprint": {
    "algorithm": "php-token-semantic-v1",
    "implementation": "app/Support/Engineering/PhpSemanticFingerprint.php",
    "ignores": [
      "T_WHITESPACE",
      "T_COMMENT",
      "T_DOC_COMMENT",
      "open/close tag formatting"
    ],
    "preserves": "PHP token identity/text and punctuation so schema/code semantic changes alter the fingerprint."
  },
  "baseline": {
    "mode": "canonical-target-sealed",
    "path": "docs/project/generated/migration-history-baseline.json",
    "seal_command": "composer migration-lifecycle:seal",
    "generated_at": "canonical-after-locked-pint-normalization",
    "rule": "Created once from the exact Docker canonical target. Packaging-side artifacts must not invent or overwrite it."
  }
}
