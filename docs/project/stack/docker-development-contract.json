{
  "schema_version": 1,
  "primary_local_runtime": "docker-development",
  "remote_development_adapters": [
    "github-codespaces"
  ],
  "compatibility_runtimes": [],
  "host_requirements": {
    "required": [
      "Linux or WSL2",
      "Docker Engine with Compose v2",
      "Git",
      "editor/browser"
    ],
    "optional": [
      "mkcert for trusted docker.songchart.test HTTPS bootstrap"
    ],
    "not_required_for_primary_runtime": [
      "host PHP",
      "host Composer",
      "host Node.js",
      "host PostgreSQL",
      "host Redis"
    ]
  },
  "development": {
    "compose_file": "compose.dev.yml",
    "services": [
      "postgres",
      "redis",
      "app",
      "queue",
      "caddy"
    ],
    "php_build": "docker/verify/Dockerfile",
    "postgres_image": "postgres:18.4-bookworm",
    "redis_image": "redis:7.4-alpine",
    "caddy_image": "caddy:2.11.3-alpine",
    "database": "songchart_docker",
    "database_role": "development",
    "https_url": "https://docker.songchart.test:8443",
    "http_url": "http://docker.songchart.test:8080",
    "persistent_volumes": [
      "songchart_dev_pgdata",
      "songchart_dev_redis",
      "songchart_dev_vendor",
      "songchart_dev_node_modules",
      "songchart_dev_composer_cache"
    ],
    "postgres_volume_mount": "/var/lib/postgresql",
    "postgres_pgdata": "/var/lib/postgresql/18/docker",
    "data_backup_entrypoint": "songchart dev db backup",
    "data_restore_entrypoint": "songchart dev db restore",
    "local_admin_bootstrap": "SONGCHART_LOCAL_ADMIN_EMAIL + admin:ensure-local; no repository password"
  },
  "demo": {
    "compose_file": "compose.demo.yml",
    "environment_template": ".env.demo.example",
    "database": "songchart_docker",
    "database_role": "development-shared",
    "shares_development_database": true,
    "shares_verification_database": false,
    "default_queue_worker": false,
    "host_port": 8001,
    "setup_entrypoint": "songchart demo setup",
    "start_entrypoint": "songchart demo up",
    "stop_entrypoint": "songchart demo down",
    "url_entrypoint": "songchart demo url"
  },
  "codespaces": {
    "status": "development-adapter",
    "auto_detect_env": "CODESPACES=true",
    "compose_override": "compose.codespaces.yml",
    "app_host_port": 8000,
    "demo_host_port": 8001,
    "port_visibility": "private-by-default",
    "https_owner": "GitHub Codespaces port forwarding proxy",
    "local_tls_required": false,
    "caddy_required": false,
    "auto_start_services": false,
    "start_entrypoints": [
      "songchart dev setup",
      "songchart dev ready",
      "songchart dev up",
      "songchart demo setup",
      "songchart demo up"
    ],
    "stop_entrypoint": "songchart dev down",
    "url_entrypoint": "songchart dev url",
    "stop_entrypoints": [
      "songchart dev down",
      "songchart demo down"
    ],
    "development_url_entrypoint": "songchart dev url",
    "demo_url_entrypoint": "songchart demo url",
    "cost_model": "Codespace compute is consumed only while the Codespace is running; repository services do not keep a stopped Codespace alive. Use the GitHub Codespaces idle timeout for automatic shutdown."
  },
  "verification": {
    "compose_file": "compose.verify.yml",
    "database": "songchart_verify_test",
    "database_role": "testing",
    "entrypoint": "songchart verify",
    "stage_entrypoint": "songchart test",
    "streamlined_closure_entrypoint": "songchart close",
    "isolated_from_development_database": true,
    "derived_manifest_refresh": "inside Docker before stage/canonical verification; only candidate --prepare may commit generated repository authority"
  },
  "cli": {
    "linux_entrypoint": "songchart",
    "commands": [
      "ai status",
      "ai doctor",
      "dev setup",
      "dev ready",
      "dev up",
      "dev down",
      "dev status",
      "dev logs",
      "dev shell",
      "dev url",
      "dev test",
      "dev db backup",
      "dev db restore",
      "demo setup",
      "demo up",
      "demo down",
      "demo status",
      "demo logs",
      "demo url",
      "artisan",
      "composer",
      "npm",
      "context",
      "candidate",
      "close",
      "test",
      "verify"
    ]
  },
  "compatibility": {
    "native_windows_cli": {
      "status": "retired",
      "supported_path": "Use WSL2/Linux and ./songchart."
    },
    "zip_handoff": {
      "status": "retired",
      "supported_path": "Use Git branches, commits and pull requests."
    }
  }
}
