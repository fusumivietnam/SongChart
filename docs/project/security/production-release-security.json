{
  "schema_version": 1,
  "stage": "19.0.6",
  "capability_owner": "security-release-readiness",
  "status": "implemented-awaiting-runtime-evidence",
  "runtime_invariants": {
    "app_env": "production",
    "app_debug": false,
    "canonical_url_scheme": "https",
    "session_secure_cookie": true,
    "session_http_only": true,
    "session_same_site": "lax",
    "admin_2fa_mode": "required",
    "first_admin_bootstrap": "interactive-no-default-password",
    "design_lab_enabled": false,
    "database": "postgresql-18",
    "external_database_transport": "tls-required-minimum",
    "queue": "redis-horizon",
    "external_redis_transport": "tls-required",
    "edge": "caddy"
  },
  "edge_invariants": {
    "automatic_https": true,
    "http_to_https": "owned-by-caddy-automatic-https",
    "headers": {
      "X-Content-Type-Options": "nosniff",
      "X-Frame-Options": "SAMEORIGIN",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "Strict-Transport-Security": "max-age=31536000",
      "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
      "Server": "removed"
    },
    "database_public_port": false,
    "redis_public_port": false
  },
  "secret_boundary": {
    "runtime_file": ".env.production",
    "tracked": false,
    "required_mode": "0600",
    "real_secrets_in_repository": false,
    "backup_file_mode": "0600",
    "diagnostics_must_redact": ["passwords", "tokens", "cookies", "private configuration"]
  },
  "supply_chain": {
    "github_actions": "immutable-commit-sha",
    "verified_dev_and_canonical_toolchain_images": "immutable-digest",
    "official_release_channel": "accepted-main",
    "official_release_requires_exact_sha_match": true,
    "local_production_like_builds_are_not_official_releases": true
  },
  "operational_readiness": {
    "host_memory_preflight": true,
    "host_disk_preflight": true,
    "dns_preflight": true,
    "queue_healthcheck": true,
    "scheduler_healthcheck": true,
    "optional_backup_mirror": "SONGCHART_BACKUP_MIRROR_DIR"
  },
  "release_evidence": [
    "./songchart prod doctor",
    "./songchart prod smoke",
    "./songchart prod db backup",
    "./songchart prod db restore-drill",
    "first production administrator bootstrap",
    "browser desktop/mobile critical smoke",
    "canonical exact-head verification"
  ],
  "acceptance_rule": "Stage 19.0.6 is accepted only after a production-like runtime passes doctor + smoke + backup/restore evidence, first-admin bootstrap is proven, and canonical verification reports no security/governance regression."
}
