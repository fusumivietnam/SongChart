  "schema_version": 1,
  "status": "canonical-machine-authority",
  "identity": {
    "internal_id": {
      "logical_type": "ulid",
      "storage": "char(26)",
      "php": "string",
      "canonical_serialization": "lowercase",
      "route_input": "case_insensitive",
      "route_pattern": "[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}"
    },
    "slug": {
      "logical_type": "slug",
      "php": "string",
      "canonical_serialization": "lowercase-ascii-hyphenated",
      "route_pattern": "[a-z0-9-]+"
    }
  },
