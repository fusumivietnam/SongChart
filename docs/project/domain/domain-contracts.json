    "fusion": {
      "evidence_table": "metadata_assertions",
      "source_table": "metadata_sources",
      "conflict_table": "metadata_conflicts",
      "selection": "field-level deterministic authority-confidence-freshness score",
      "canonical_write_policy": "resolver is read/evidence selection only; canonical mutation remains explicit",
      "provider_neutral": true,
      "identity_bridge": {
        "identifier_table": "external_identifiers",
        "destination_table": "provider_destinations",
        "canonical_identity_policy": "provider identifiers and destinations attach to one SongChart entity and never replace its ULID",
        "read_only": true
      },
      "enrichment_planner": {
        "recipe_authority": "config/catalog-enrichment.php",
        "inputs": [
          "metadata_assertions",
          "external_identifiers",
          "provider_destinations",
          "providers"
        ],
        "outputs": [
          "missing_field",
          "missing_identifier",
          "missing_destination",
          "provider",
          "priority",
          "cost_class",
          "provider_enabled"
        ],
        "calls_provider_apis": false,
        "mutates_canonical_catalog": false
      }
    }
  },
  "discovery": {
