  "raw_literal_rules": [
    {
      "authority": "database-test",
      "literal": "@php scripts/run-database-tests.php postgres --prepare-schema",
      "scan_paths": [
        "tests/Architecture/*.php",
        "scripts/*.php"
      ],
      "allowed_files": [
        "scripts/verify-database-authority.php",
        "scripts/verify-runtime-authority-closure.php",
        "scripts/verify-database-test-isolation.php"
      ]
    },
    {
      "authority": "release-pipeline",
      "literal": "@lockfile-authority:release",
      "scan_paths": [
        "tests/Architecture/*.php",
        "scripts/*.php"
      ],
      "allowed_files": [
        "scripts/verify-performance-baseline.php",
        "scripts/verify-release-orchestration.php"
      ]
    }
  ],
  "policy": {
    "single_executable_authority": true,
    "consumer_literals_forbidden_unless_allowlisted": true,
    "compiled_manifest_required": true,
    "canonical_before_packaging": true,
    "impact_resolution_before_implementation": true,
    "derived_manifest_compiled_on_exact_target_tree": true,
    "packaged_generated_manifest_is_not_cross_environment_authority": true
  }
}
