{
    "schema_version": 2,
    "public_entrypoints": {
        "development": [
            "songchart ai status",
            "songchart ai doctor",
            "songchart impact",
            "songchart impact --diff",
            "songchart impact --verify",
            "songchart reconcile",
            "songchart audit",
            "songchart dev setup",
            "songchart dev ready",
            "songchart dev up",
            "songchart dev status",
            "songchart dev logs",
            "songchart dev shell",
            "songchart dev test",
            "songchart dev db backup",
            "songchart dev db restore",
            "songchart demo setup",
            "songchart demo up",
            "songchart demo down",
            "songchart demo status",
            "songchart demo logs",
            "songchart demo url",
            "songchart context"
        ],
        "diagnostic": [
            "songchart impact",
            "songchart impact --diff",
            "songchart reconcile",
            "songchart audit"
        ],
        "focused": [
            "songchart impact --verify",
            "songchart dev test",
            "songchart dev test --no-build",
            "songchart test"
        ],
        "candidate_closure": [
            "songchart candidate",
            "composer stage:verify"
        ],
        "canonical_closure": [
            "songchart close",
            "songchart verify",
            "composer canonical:verify"
        ],
        "packaging": [
            "composer release:package"
        ]
    },
    "internal_building_blocks": [
        "quality:normalize",
        "quality:verify",
        "test:postgres",
        "repository-contracts:verify",
        "verification-topology:verify",
        "ai-protocol:verify",
        "runtime-artifact:verify",
        "artifact-provenance:verify"
    ],
    "removed_aliases": {
        "verify": "Use composer stage:verify or songchart test.",
        "release:verify": "Use composer canonical:verify or songchart verify.",
        "test:all": "Use composer test:postgres or songchart test.",
        "test:postgres-clean": "Use composer test:postgres; schema preparation is already authoritative.",
        "release-contract:verify": "Repository/canonical closure owns these gates.",
        "delivery:verify": "Use composer release:package after canonical/provenance PASS."
    },
    "historical_orchestration": {
        "retired_files": [
            "songchart.bat",
            "stage-verify.bat",
            "verify-songchart.bat",
            "docker-dev-setup.bat",
            "docker-dev-up.bat",
            "docker-dev-down.bat",
            "scripts/songchart.ps1",
            "scripts/verify-canonical.ps1",
            "scripts/ai-status.ps1"
        ],
        "reason": "Git + Linux/WSL2 + Docker is the sole active development and verification workflow; native Windows and ZIP handoff compatibility were retired."
    },
    "policy": {
        "active_docs_must_use_public_entrypoints": true,
        "removed_aliases_must_not_be_defined": true,
        "historical_docs_may_reference_removed_commands": true,
        "new_verifier_requires_registered_authority_owner": true,
        "diagnostic_entrypoints_do_not_replace_closure": true
    },
    "host_entrypoints": {
        "primary_linux_wsl": "./songchart",
        "native_windows": "retired-use-wsl2",
        "development_compose_project": "songchart-dev",
        "demo_compose_project": "songchart-demo",
        "verification_compose_project": "songchart-verify"
    }
}
