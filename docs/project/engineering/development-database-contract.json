{
  "schema_version": 1,
  "owner": "development-database-authority",
  "application_connection": "pgsql",
  "modes": {
    "remote": {
      "preferred_provider": "neon",
      "requires_database_url": true,
      "requires_tls": true,
      "allows_local_host_fallback": false,
      "durability": "provider-owned"
    },
    "local": {
      "explicit_fallback_only": true,
      "default_container_host": "postgres",
      "durability": "developer-owned"
    }
  },
  "testing": {
    "authority": "isolated-postgresql-test-lane",
    "must_not_reuse_development_database": true,
    "disposable": true
  },
  "backup_artifacts": {
    "development_database_directory": ".songchart-db-backups",
    "source_overwrite_backup_directory": ".songchart-backups",
    "must_not_share_source_overwrite_directory": true,
    "tracked": false,
    "restore_requires_explicit_confirmation": true
  },
  "fail_closed": [
    "remote mode without DB_URL",
    "remote mode resolving to a local PostgreSQL host",
    "remote mode without TLS",
    "unexpected development database identity",
    "configured durable database becoming unreachable"
  ],
  "secrets": {
    "committed": false,
    "app_key_must_remain_stable": true
  }
}
