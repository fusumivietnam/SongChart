{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://songchart.local/schemas/use-case-contract.schema.json",
  "title": "SongChart Use Case Contract",
  "type": "object",
  "required": ["id", "title", "actors", "entrypoints", "application", "tests"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "active", "accepted", "retired"]},
    "actors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "entrypoints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "application": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "domain": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "persistence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "outbound": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "events": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "security_boundaries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tests": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "documentation": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "owner": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
