  "version": 1,
  "authorities": {
    "database-test-authority": {
      "state": "postgresql-only-release-authority",
      "authority_files": [
        "composer.json",
        ".github/workflows/tests.yml",
        "docs/project/stack/database-test-contract.json"
      ],
      "dependents": [
        "scripts/verify-database-authority.php",
        "scripts/verify-runtime-authority-closure.php",
        "scripts/verify-foundation-closure.php",
        "scripts/verify-code-generation-guardrails.php",
        "tests/Architecture/PostgresFirstDatabaseAuthorityTest.php",
        "tests/Architecture/RepositoryRuntimeAuthorityClosureTest.php",
        "tests/Architecture/TestingAndCiGatesTest.php",
        "tests/Architecture/TestAuthorityCodeGenerationGuardrailsTest.php",
        "docs/setup/TEST_DATABASE_SETUP.md",
        "docs/project/docs/TESTING.md",
        "docs/project/stack/DATABASE_CONVENTIONS.md"
      ],
      "scan_paths": [
        "composer.json",
        ".github/workflows/tests.yml",
        "scripts/*.php",
        "tests/Architecture/*.php"
      ],
      "deprecated_patterns": [
        {
          "regex": "->toBe\\(['\\\"]@test:sqlite['\\\"]\\)",
          "message": "Architecture tests must not assert SQLite as the official test alias."
        },
        {
          "regex": "(?<!not)->toContain\\([^\\n]*['\\\"]@test:sqlite['\\\"]",
          "message": "Architecture tests must not require SQLite in the release matrix."
        },
        {
          "regex": "(?m)^\\s*tests-sqlite:\\s*$",
          "message": "SQLite CI job is deprecated; PostgreSQL is the only release DB lane."
        },
        {
          "regex": "(?m)^\\s*-\\s*run:\\s*composer\\s+test:sqlite(?:\\s|$)",
          "message": "CI must not execute SQLite as a release test lane."
        },
        {
          "regex": "->toContain\\(['\\\"]run-database-tests\\.php sqlite['\\\"]\\)",
          "message": "Official database-backed test aliases must resolve to PostgreSQL."
        }
      ]
    },
