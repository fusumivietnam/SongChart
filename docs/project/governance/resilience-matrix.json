{
  "schema_version": 1,
  "execution_profiles": {
    "light": {
      "purpose": "constrained developer hardware or quota fallback",
      "requires": ["php", "node", "git"],
      "optional": ["docker", "redis", "browser"],
      "default_verification": ["authority", "static", "focused"]
    },
    "standard": {
      "purpose": "normal local or Codespaces development",
      "requires": ["php", "node", "docker", "postgresql", "redis"],
      "default_verification": ["authority", "static", "focused", "postgresql"]
    },
    "full": {
      "purpose": "closure and release confidence",
      "requires": ["docker", "postgresql", "redis", "browser", "frontend_build"],
      "default_verification": ["canonical"]
    }
  },
  "capabilities": {
    "source": {
      "primary": "github_repository",
      "fallback": ["trusted_local_clone"],
      "offline": true,
      "authority": "git_commit_and_tree"
    },
    "development_environment": {
      "primary": "linux_docker_compose",
      "adapters": ["github_codespaces", "wsl2_docker"],
      "fallback": ["light_profile"],
      "codespaces_required": false
    },
    "ci": {
      "primary": "github_hosted_actions",
      "fallback": ["trusted_self_hosted_runner", "local_candidate_evidence"],
      "policy": "fallback_evidence_never_silently_weakens_owner_merge_gate"
    },
    "development_database": {
      "primary": "durable_external_postgresql_when_configured",
      "fallback": ["local_docker_postgresql"],
      "local_state_authoritative_shared_data": false
    },
    "verification_database": {
      "primary": "disposable_postgresql",
      "fallback": ["trusted_local_disposable_postgresql"]
    },
    "browser_verification": {
      "primary": "github_actions_playwright",
      "fallback": ["self_hosted_playwright", "local_playwright"],
      "required_on_light_profile": false
    },
    "dependency_cache": {
      "primary": ["composer_cache", "npm_cache", "playwright_cache", "docker_layers"],
      "fallback": "rebuild_from_lockfiles",
      "cache_is_authority": false
    },
    "ai_continuity": {
      "primary": "repository_native_authorities",
      "clients": ["chatgpt", "other_ai_agents", "human_developer"],
      "conversation_memory_required": false
    }
  },
  "quota_policy": {
    "never_skip_required_semantic_verification_due_to_quota": true,
    "prefer_impact_driven_verification": true,
    "closure_can_use_trusted_self_hosted_runner": true,
    "local_fallback_requires_exact_git_sha_and_environment_evidence": true
  },
  "hardware_policy": {
    "development_must_not_require_full_profile": true,
    "closure_may_run_remotely": true,
    "resource_intensive_services_must_be_optional_outside_full_profile": true
  }
}
