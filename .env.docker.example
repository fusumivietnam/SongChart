APP_NAME=SongChart
APP_VERSION=unreleased
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://docker.songchart.test:8443
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=songchart_docker
DB_USERNAME=songchart_docker
DB_PASSWORD=songchart_docker_only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=docker.songchart.test
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@docker.songchart.test
MAIL_FROM_NAME="${APP_NAME}"

DESIGN_LAB_ENABLED=true
SONGCHART_ADMIN_2FA_MODE=disabled
SONGCHART_TRUST_DOCKER_PROXY=true

# Local-only privileged bootstrap. The email is intentionally non-routable and safe for dev/Codespaces.
# The password is never stored in source; admin:ensure-local prompts only when the local account must be created/recreated.
SONGCHART_LOCAL_ADMIN_EMAIL=admin@songchart.local
SONGCHART_LOCAL_ADMIN_NAME=SongChart Admin
SONGCHART_LOCAL_ADMIN_ROLE=super_admin

SONGCHART_PROVIDER_HEALTH_QUEUE=provider-health
SONGCHART_PROVIDER_HEALTH_SCHEDULE_ENABLED=true
SONGCHART_PROVIDER_HEALTH_STALE_AFTER_MINUTES=15
SONGCHART_PROVIDER_IMPORT_QUEUE=provider-imports
SONGCHART_PROVIDER_NORMALIZATION_QUEUE=provider-normalization

SONGCHART_DISCOVERY_QUEUE=discovery-projections
SONGCHART_DISCOVERY_SCHEDULE_ENABLED=true
SONGCHART_DISCOVERY_PROJECTION_BATCH_SIZE=250
SONGCHART_DISCOVERY_PROJECTION_TTL_MINUTES=15

PULSE_ENABLED=true
PULSE_PATH=pulse
PULSE_STORAGE_DRIVER=database
PULSE_STORAGE_KEEP="7 days"
PULSE_INGEST_DRIVER=storage

ANALYTICS_DRIVER=null
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_LARAVEL_DSN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_KEY=
MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_USER_AGENT="SongChart/unreleased (contact@example.com)"
MUSICBRAINZ_CONNECT_TIMEOUT_SECONDS=5
MUSICBRAINZ_TIMEOUT_SECONDS=15
MUSICBRAINZ_RATE_STRATEGY=minimum_interval
MUSICBRAINZ_MINIMUM_INTERVAL_MS=1100
MUSICBRAINZ_DEFAULT_COOLDOWN_SECONDS=2
MUSICBRAINZ_MAXIMUM_COOLDOWN_SECONDS=900
MUSICBRAINZ_RATE_LOCK_WAIT_SECONDS=10
YOUTUBE_API_KEY=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=
SOUNDCLOUD_CLIENT_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Privileged business audit
ACTIVITYLOG_ENABLED=true
ACTIVITYLOG_CLEAN_AFTER_DAYS=365

# YouTube Data API v3 - disabled until an API key and policy review are explicit.
YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=
YOUTUBE_BASE_URL=https://www.googleapis.com
YOUTUBE_CONNECT_TIMEOUT_SECONDS=5
YOUTUBE_TIMEOUT_SECONDS=15
YOUTUBE_SEARCH_DAILY_LIMIT=100
YOUTUBE_GENERAL_DAILY_UNITS=10000
