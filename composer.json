{
    "$schema":  "https://getcomposer.org/schema.json",
    "name":  "songchart/songchart-web",
    "type":  "project",
    "description":  "SongChartWeb music discovery, metadata and provider navigation platform.",
    "keywords":  [
                     "laravel",
                     "music",
                     "metadata",
                     "discovery"
                 ],
    "license":  "proprietary",
    "require":  {
                    "composer/semver":  "^3.4",
                    "laravel/fortify":  "^1.30",
                    "laravel/framework":  "^13.0",
                    "laravel/horizon":  "^5.48",
                    "laravel/pulse":  "^1.7.4",
                    "laravel/tinker":  "^3.0",
                    "livewire/livewire":  "^4.0",
                    "php":  "^8.5",
                    "spatie/laravel-activitylog":  "^5.0"
                },
    "require-dev":  {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.8",
        "laravel/boost": "^2.7",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload":  {
                     "psr-4":  {
                                   "App\\":  "app/",
                                   "Database\\Factories\\":  "database/factories/",
                                   "Database\\Seeders\\":  "database/seeders/"
                               }
                 },
    "autoload-dev":  {
                         "psr-4":  {
                                       "Tests\\":  "tests/"
                                   }
                     },
    "scripts":  {
                    "setup":  [
                                  "@php -r \"file_exists(\u0027.env\u0027) || copy(\u0027.env.example\u0027, \u0027.env\u0027);\"",
                                  "@php artisan key:generate",
                                  "@php artisan migrate --force",
                                  "npm ci",
                                  "npm run build"
                              ],
                    "dev":  [
                                "Composer\\Config::disableProcessTimeout",
                                "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names=server,queue,vite --kill-others"
                            ],
                    "test":  "@test:postgres",
                    "analyse":  "vendor/bin/phpstan analyse",
                    "format":  "vendor/bin/pint",
                    "post-autoload-dump":  [
                                               "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
                                               "@php artisan package:discover --ansi"
                                           ],
                    "post-update-cmd":  [
                                            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
                                        ],
                    "post-root-package-install":  [
                                                      "@php -r \"file_exists(\u0027.env\u0027) || copy(\u0027.env.example\u0027, \u0027.env\u0027);\""
                                                  ],
                    "post-create-project-cmd":  [
                                                    "@php artisan key:generate --ansi",
                                                    "@php artisan migrate --graceful --ansi"
                                                ],
                    "lint":  [
                                 "@source:verify",
                                 "vendor/bin/pint --test",
                                 "vendor/bin/phpstan analyse"
                             ],
                    "docs:verify":  "@php scripts/verify-documentation.php",
                    "alignment:verify":  "@php scripts/verify-laravel-alignment.php",
                    "quality:normalize":  "vendor/bin/pint",
                    "source:verify":  "@php scripts/verify-source-package.php",
