APP_NAME=SongChartWeb
APP_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://songchart.test
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=songchart
DB_USERNAME=songchart_admin
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=database

# Redis queue runtime (Horizon on Linux/WSL; native Laravel Redis queue on Windows/Laragon)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=180
HORIZON_NAME=SongChartWeb
HORIZON_PATH=horizon

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@songchart.test"
MAIL_FROM_NAME="${APP_NAME}"

# Operational providers are disabled until credentials and policy review exist.
ANALYTICS_DRIVER=null
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_LARAVEL_DSN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_KEY=

# Music providers
MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_USER_AGENT="SongChartWeb/0.1 (contact@example.com)"
MUSICBRAINZ_CONNECT_TIMEOUT_SECONDS=5
MUSICBRAINZ_TIMEOUT_SECONDS=15
MUSICBRAINZ_RATE_STRATEGY=minimum_interval
MUSICBRAINZ_MINIMUM_INTERVAL_MS=1100
MUSICBRAINZ_DEFAULT_COOLDOWN_SECONDS=2
MUSICBRAINZ_MAXIMUM_COOLDOWN_SECONDS=900
MUSICBRAINZ_RATE_LOCK_WAIT_SECONDS=10
YOUTUBE_API_KEY=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=
SOUNDCLOUD_CLIENT_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Frontend reference routes
DESIGN_LAB_ENABLED=true

# Provider async infrastructure
SONGCHART_PROVIDER_HEALTH_QUEUE=provider-health
SONGCHART_PROVIDER_HEALTH_SCHEDULE_ENABLED=true
SONGCHART_PROVIDER_HEALTH_STALE_AFTER_MINUTES=15
SONGCHART_PROVIDER_IMPORT_QUEUE=provider-imports
SONGCHART_PROVIDER_NORMALIZATION_QUEUE=provider-normalization

# Local development safety
# User-configurable. Keep it different from DB_DATABASE and use the *_test suffix so the destructive-test bootstrap can fail closed before a marker exists.
TEST_PGSQL_DATABASE=songchart_test
SONGCHART_ADMIN_2FA_MODE=disabled

# Discovery projection pipeline
SONGCHART_DISCOVERY_QUEUE=discovery-projections
SONGCHART_DISCOVERY_SCHEDULE_ENABLED=true
SONGCHART_DISCOVERY_PROJECTION_BATCH_SIZE=250
SONGCHART_DISCOVERY_PROJECTION_TTL_MINUTES=15

# Laravel Pulse operational observability
PULSE_ENABLED=true
PULSE_PATH=pulse
PULSE_STORAGE_DRIVER=database
PULSE_STORAGE_KEEP="7 days"
PULSE_DB_CONNECTION=
PULSE_INGEST_DRIVER=storage
PULSE_REDIS_CONNECTION=
PULSE_CACHE_DRIVER=
PULSE_SLOW_QUERIES_THRESHOLD=500
PULSE_SLOW_REQUESTS_THRESHOLD=1000
PULSE_SLOW_JOBS_THRESHOLD=1000
PULSE_SLOW_OUTGOING_REQUESTS_THRESHOLD=1000
PULSE_SERVER_NAME=
PULSE_SERVER_DIRECTORIES=


# Privileged business audit
ACTIVITYLOG_ENABLED=true
ACTIVITYLOG_CLEAN_AFTER_DAYS=365

# YouTube Data API v3 - disabled until an API key and policy review are explicit.
YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=
YOUTUBE_BASE_URL=https://www.googleapis.com
YOUTUBE_CONNECT_TIMEOUT_SECONDS=5
YOUTUBE_TIMEOUT_SECONDS=15
YOUTUBE_SEARCH_DAILY_LIMIT=100
YOUTUBE_GENERAL_DAILY_UNITS=10000

# Development PostgreSQL authority.
# "remote" is the durable development mode; "local" is an explicit fallback.
SONGCHART_DEV_DATABASE_MODE=local
SONGCHART_DEV_DATABASE_EXPECTED_NAME=
