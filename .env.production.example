# SongChart production environment template.
# Runtime copy: .env.production (gitignored, chmod 0600). Never commit real secrets.

APP_NAME=SongChart
APP_VERSION=unreleased
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://songchart.example
APP_TIMEZONE=UTC
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
SONGCHART_PRODUCTION_ENVIRONMENT_GUARD=true

# Installation/deployment boundary. Internal Compose service names/ports stay stable.
SONGCHART_INSTANCE=songchart-production
SONGCHART_DOMAIN=songchart.example
SONGCHART_ACME_EMAIL=
SONGCHART_HTTP_PORT=80
SONGCHART_HTTPS_PORT=443
SONGCHART_DATABASE_MODE=bundled
SONGCHART_REDIS_MODE=bundled
SONGCHART_RELEASE_SHA=unknown
SONGCHART_IMAGE_TAG=local
SONGCHART_BUILD_DATE=unknown

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=songchart
DB_USERNAME=songchart
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=0
REDIS_QUEUE_RETRY_AFTER=180
SONGCHART_QUEUE_NAMES=critical,discovery-projections,provider-health,provider-imports,provider-normalization,notifications,default
SONGCHART_QUEUE_MONITOR_MAX=100

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

DESIGN_LAB_ENABLED=false
SONGCHART_ADMIN_2FA_MODE=required
SONGCHART_TRUST_DOCKER_PROXY=true

SONGCHART_PROVIDER_HEALTH_QUEUE=provider-health
SONGCHART_PROVIDER_HEALTH_SCHEDULE_ENABLED=true
SONGCHART_PROVIDER_HEALTH_STALE_AFTER_MINUTES=15
SONGCHART_PROVIDER_IMPORT_QUEUE=provider-imports
SONGCHART_PROVIDER_NORMALIZATION_QUEUE=provider-normalization

SONGCHART_DISCOVERY_QUEUE=discovery-projections
SONGCHART_DISCOVERY_SCHEDULE_ENABLED=true
SONGCHART_DISCOVERY_PROJECTION_BATCH_SIZE=250
SONGCHART_DISCOVERY_PROJECTION_TTL_MINUTES=15

HORIZON_NAME=SongChart
HORIZON_PATH=horizon
PULSE_ENABLED=true
PULSE_PATH=pulse
PULSE_STORAGE_DRIVER=database
PULSE_STORAGE_KEEP="7 days"
PULSE_INGEST_DRIVER=storage

# Service-provider credentials remain blank until the provider is enabled and approved.
ANALYTICS_DRIVER=null
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_LARAVEL_DSN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_KEY=

# Data/destination providers remain disabled until credentials/policy requirements are satisfied.
MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_USER_AGENT=
MUSICBRAINZ_CONNECT_TIMEOUT_SECONDS=5
MUSICBRAINZ_TIMEOUT_SECONDS=15
MUSICBRAINZ_RATE_STRATEGY=minimum_interval
MUSICBRAINZ_MINIMUM_INTERVAL_MS=1100
MUSICBRAINZ_DEFAULT_COOLDOWN_SECONDS=2
MUSICBRAINZ_MAXIMUM_COOLDOWN_SECONDS=900
MUSICBRAINZ_RATE_LOCK_WAIT_SECONDS=10

YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=
YOUTUBE_BASE_URL=https://www.googleapis.com
YOUTUBE_CONNECT_TIMEOUT_SECONDS=5
YOUTUBE_TIMEOUT_SECONDS=15
YOUTUBE_SEARCH_DAILY_LIMIT=100
YOUTUBE_GENERAL_DAILY_UNITS=10000

# Privileged business audit remains enabled in production.
ACTIVITYLOG_ENABLED=true
ACTIVITYLOG_CLEAN_AFTER_DAYS=365
