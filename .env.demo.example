APP_NAME=SongChartWeb
APP_VERSION=1.0.0
APP_ENV=demo
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=songchart_docker
DB_USERNAME=songchart_docker
DB_PASSWORD=songchart_docker_only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

DESIGN_LAB_ENABLED=false
SONGCHART_ADMIN_2FA_MODE=disabled
SONGCHART_TRUST_DOCKER_PROXY=true

MUSICBRAINZ_ENABLED=false
YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=
