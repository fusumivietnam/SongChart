#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEV_COMPOSE="$ROOT/compose.dev.yml"
CODESPACES_COMPOSE="$ROOT/compose.codespaces.yml"
DEMO_COMPOSE="$ROOT/compose.demo.yml"
VERIFY_COMPOSE="$ROOT/compose.verify.yml"
DEV_PROJECT="${SONGCHART_DEV_PROJECT:-songchart-dev}"
DEMO_PROJECT="${SONGCHART_DEMO_PROJECT:-songchart-demo}"
VERIFY_PROJECT="${SONGCHART_VERIFY_PROJECT:-songchart-verify}"
DEV_DB_BACKUP_DIR="${SONGCHART_DEV_DB_BACKUP_DIR:-$ROOT/.songchart-db-backups}"
export SONGCHART_HOST_UID="${SONGCHART_HOST_UID:-$(id -u)}"
export SONGCHART_HOST_GID="${SONGCHART_HOST_GID:-$(id -g)}"
die(){ printf 'SongChart: %s\n' "$*" >&2; exit 1; }
codespaces_mode(){ [[ "${CODESPACES:-false}" == "true" ]]; }
if codespaces_mode; then
  [[ -f "$CODESPACES_COMPOSE" ]] || die 'compose.codespaces.yml is required in GitHub Codespaces.'
  [[ -n "${CODESPACE_NAME:-}" ]] || die 'CODESPACE_NAME is required in GitHub Codespaces.'
  export SONGCHART_CODESPACES_APP_URL="https://${CODESPACE_NAME}-8000.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN:-app.github.dev}"
  export SONGCHART_DEMO_APP_URL="https://${CODESPACE_NAME}-8001.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN:-app.github.dev}"
else
  export SONGCHART_DEMO_APP_URL="${SONGCHART_DEMO_APP_URL:-http://127.0.0.1:8001}"
fi
export SONGCHART_DEMO_PORT="${SONGCHART_DEMO_PORT:-8001}"
require_docker(){ command -v docker >/dev/null 2>&1 || die 'Docker CLI is required.'; docker version >/dev/null 2>&1 || die 'Docker Engine is not reachable.'; docker compose version >/dev/null 2>&1 || die 'Docker Compose v2 plugin is required.'; }
ensure_dev_config(){ [[ -f "$ROOT/.env.docker" ]] || die '.env.docker is missing. Run: ./songchart dev setup'; }
ensure_demo_config(){ [[ -f "$ROOT/.env.demo" ]] || die '.env.demo is missing. Run: ./songchart demo setup'; }
dev(){
  if codespaces_mode; then
    docker compose -p "$DEV_PROJECT" -f "$DEV_COMPOSE" -f "$CODESPACES_COMPOSE" "$@"
  else
    docker compose -p "$DEV_PROJECT" -f "$DEV_COMPOSE" "$@"
  fi
}
demo(){ docker compose -p "$DEMO_PROJECT" -f "$DEMO_COMPOSE" "$@"; }
verify_compose(){ docker compose -p "$VERIFY_PROJECT" -f "$VERIFY_COMPOSE" "$@"; }
dev_app_running(){ [[ "$(dev ps --status running --services 2>/dev/null | grep -x 'app' || true)" == 'app' ]]; }
dev_up(){
  local mode
  mode="$(dev_db_mode)"
  if [[ "$mode" == 'local' ]]; then
    if codespaces_mode; then
      dev up -d postgres redis app queue
    else
      dev up -d postgres redis app queue caddy
    fi
  else
    printf '[SongChart dev] Using durable remote PostgreSQL authority; local postgres service will not be started.\n'
    if codespaces_mode; then
      dev up -d redis app queue
    else
      dev up -d redis app queue caddy
    fi
  fi
}
dev_url(){
  if codespaces_mode; then
    printf '%s\n' "$SONGCHART_CODESPACES_APP_URL"
  else
    printf '%s\n' 'https://docker.songchart.test:8443'
  fi
}
demo_url(){ printf '%s\n' "$SONGCHART_DEMO_APP_URL"; }
dev_exec_or_run(){
  if dev_app_running; then
    dev exec app "$@"
  else
    dev run --rm app "$@"
  fi
}
env_value(){
  local file="$1" key="$2"
  grep -m1 -E "^${key}=" "$file" 2>/dev/null | cut -d= -f2- | sed -E 's/^"(.*)"$/\1/' || true
}
dev_db_mode(){
  local mode
  mode="$(env_value "$ROOT/.env.docker" SONGCHART_DEV_DATABASE_MODE)"
  [[ -n "$mode" ]] || mode='local'
  case "$mode" in
    local|remote) printf '%s\n' "$mode" ;;
    *) die 'SONGCHART_DEV_DATABASE_MODE must be local or remote.' ;;
  esac
}
dev_db_assert_identity(){
  dev_exec_or_run php artisan development:database-status --json >/dev/null \
    || die 'Development database identity/connectivity verification failed.'
}
lock_fingerprint(){ cat "$@" | sha256sum | awk '{print $1}'; }
ensure_local_admin(){
  local email name role
  email="$(env_value "$ROOT/.env.docker" SONGCHART_LOCAL_ADMIN_EMAIL)"
  [[ -n "$email" ]] || return 0
  name="$(env_value "$ROOT/.env.docker" SONGCHART_LOCAL_ADMIN_NAME)"
  role="$(env_value "$ROOT/.env.docker" SONGCHART_LOCAL_ADMIN_ROLE)"
  [[ -n "$name" ]] || name='SongChart Admin'
  [[ -n "$role" ]] || role='super_admin'
  printf '[SongChart dev] Ensuring configured local administrator %s.\n' "$email"
  dev_exec_or_run php artisan admin:ensure-local "$email" "--name=$name" "--role=$role"
}
ensure_dev_dependencies(){
  local composer_fingerprint npm_fingerprint current
  composer_fingerprint="$(lock_fingerprint "$ROOT/composer.json" "$ROOT/composer.lock")"
  current="$(dev run --rm -T app sh -lc 'cat /workspace/vendor/.songchart-composer-fingerprint 2>/dev/null || true')"
  if [[ "$current" != "$composer_fingerprint" ]] || ! dev run --rm -T app test -f /workspace/vendor/autoload.php; then
    printf '[SongChart dev] Hydrating locked Composer dependencies for fingerprint %s.\n' "$composer_fingerprint"
    dev run --rm app composer install --no-interaction --prefer-dist --no-progress
    dev run --rm -T app sh -lc "printf '%s\\n' '$composer_fingerprint' > /workspace/vendor/.songchart-composer-fingerprint"
  else
    printf '[SongChart dev] Reusing locked Composer dependencies for fingerprint %s.\n' "$composer_fingerprint"
  fi

  npm_fingerprint="$(lock_fingerprint "$ROOT/package.json" "$ROOT/package-lock.json")"
  current="$(dev run --rm -T app sh -lc 'cat /workspace/node_modules/.songchart-npm-fingerprint 2>/dev/null || true')"
  if [[ "$current" != "$npm_fingerprint" ]] || ! dev run --rm -T app test -x /workspace/node_modules/.bin/vite; then
    printf '[SongChart dev] Hydrating locked npm dependencies for fingerprint %s.\n' "$npm_fingerprint"
    dev run --rm app npm ci --no-audit --no-fund
    dev run --rm -T app sh -lc "printf '%s\\n' '$npm_fingerprint' > /workspace/node_modules/.songchart-npm-fingerprint"
  else
    printf '[SongChart dev] Reusing locked npm dependencies for fingerprint %s.\n' "$npm_fingerprint"
  fi

  current="$(dev run --rm -T app sh -lc 'cat /ms-playwright/.songchart-playwright-fingerprint 2>/dev/null || true')"
  if [[ "$current" != "$npm_fingerprint" ]] || ! dev run --rm -T app sh -lc 'find /ms-playwright -maxdepth 1 -type d -name "chromium-*" -print -quit | grep -q .'; then
    printf '[SongChart dev] Hydrating verified Playwright Chromium runtime for fingerprint %s.\n' "$npm_fingerprint"
    dev run --rm app npx playwright install chromium
    dev run --rm -T app sh -lc "printf '%s\\n' '$npm_fingerprint' > /ms-playwright/.songchart-playwright-fingerprint"
  else
    printf '[SongChart dev] Reusing Playwright Chromium runtime for fingerprint %s.\n' "$npm_fingerprint"
  fi
}
repair_dev_runtime_ownership(){
  printf '[SongChart dev] Repairing generated runtime ownership for UID:GID %s:%s.\n' "$SONGCHART_HOST_UID" "$SONGCHART_HOST_GID"
  dev run --rm --user root app sh -lc \
    "mkdir -p /workspace/vendor /workspace/node_modules /ms-playwright /workspace/public/build /workspace/bootstrap/cache /workspace/storage/framework/cache/data /workspace/storage/framework/sessions /workspace/storage/framework/views /workspace/storage/logs /tmp/composer-cache /tmp/npm-cache && chown -R $SONGCHART_HOST_UID:$SONGCHART_HOST_GID /workspace/vendor /workspace/node_modules /ms-playwright /workspace/public/build /workspace/bootstrap/cache /workspace/storage /tmp/composer-cache /tmp/npm-cache"
}
dev_db_backup(){
  ensure_dev_config
  local mode stamp target db_url
  mode="$(dev_db_mode)"
  mkdir -p "$DEV_DB_BACKUP_DIR"
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  target="$DEV_DB_BACKUP_DIR/songchart-dev-$stamp.dump"

  if [[ "$mode" == 'local' ]]; then
    dev up -d postgres >/dev/null
    dev_db_assert_identity
    printf '[SongChart dev db] Backing up local development PostgreSQL to %s.\n' "$target"
    dev exec -T postgres pg_dump -U songchart_docker -d songchart_docker -Fc > "$target"
  else
    db_url="$(env_value "$ROOT/.env.docker" DB_URL)"
    [[ -n "$db_url" ]] || die 'Remote development database backup requires DB_URL in .env.docker.'
    dev_db_assert_identity
    printf '[SongChart dev db] Backing up durable remote PostgreSQL to %s.\n' "$target"
    docker run --rm --env-file "$ROOT/.env.docker" postgres:18.4-bookworm \
      sh -lc 'export PGSSLMODE="${DB_SSLMODE:-require}"; exec pg_dump "$DB_URL" --format=custom --no-owner --no-privileges' \
      > "$target"
  fi

  cp "$target" "$DEV_DB_BACKUP_DIR/songchart-dev-latest.dump"
  printf '[SongChart dev db] Backup complete.\n'
}
dev_db_restore(){
  ensure_dev_config
  local mode source db_url
  mode="$(dev_db_mode)"
  source="${1:-$DEV_DB_BACKUP_DIR/songchart-dev-latest.dump}"
  [[ -f "$source" ]] || die "Development database backup not found: $source"
  printf 'Restore development database from %s? Existing development data will be replaced. [y/N] ' "$source"
  local answer
  read -r answer
  [[ "$answer" =~ ^[Yy]$ ]] || { printf '[SongChart dev db] Restore cancelled.\n'; return 0; }

  if [[ "$mode" == 'local' ]]; then
    dev up -d postgres >/dev/null
  else
    db_url="$(env_value "$ROOT/.env.docker" DB_URL)"
    [[ -n "$db_url" ]] || die 'Remote development database restore requires DB_URL in .env.docker.'
  fi
  dev_db_assert_identity

  printf '[SongChart dev db] Creating pre-restore database backup.\n'
  dev_db_backup

  if [[ "$mode" == 'local' ]]; then
    dev exec -T postgres pg_restore --clean --if-exists --no-owner --no-privileges -U songchart_docker -d songchart_docker < "$source"
  else
    docker run --rm -i --env-file "$ROOT/.env.docker" postgres:18.4-bookworm \
      sh -lc 'export PGSSLMODE="${DB_SSLMODE:-require}"; exec pg_restore --clean --if-exists --no-owner --no-privileges --dbname="$DB_URL"' \
      < "$source"
  fi

  printf '[SongChart dev db] Restore complete.\n'
  dev_db_assert_identity
  ensure_local_admin
}
setup_demo(){
  ensure_dev_config
  [[ -f "$ROOT/.env.demo" ]] || cp "$ROOT/.env.demo.example" "$ROOT/.env.demo"
  if grep -Eq '^APP_KEY=[[:space:]]*$' "$ROOT/.env.demo"; then
    local app_key
    app_key="base64:$(head -c 32 /dev/urandom | base64 | tr -d '\n')"
    sed -i -E "s|^APP_KEY=[[:space:]]*$|APP_KEY=$app_key|" "$ROOT/.env.demo"
  fi
  if grep -Eq '^APP_URL=' "$ROOT/.env.demo"; then
    sed -i -E "s|^APP_URL=.*$|APP_URL=$SONGCHART_DEMO_APP_URL|" "$ROOT/.env.demo"
  else
    printf '\nAPP_URL=%s\n' "$SONGCHART_DEMO_APP_URL" >> "$ROOT/.env.demo"
  fi
  printf '[SongChart demo] URL authority: %s\n' "$SONGCHART_DEMO_APP_URL"
  printf '[SongChart demo] Ensuring development PostgreSQL authority is running.\n'
  dev up -d postgres
  demo build app
  printf '[SongChart demo] Repairing dependency/runtime ownership for UID:GID %s:%s.\n' "$SONGCHART_HOST_UID" "$SONGCHART_HOST_GID"
  demo run --rm --user root app sh -lc \
    "mkdir -p /workspace/vendor /workspace/node_modules /workspace/public/build /workspace/bootstrap/cache /workspace/storage /tmp/composer-cache /tmp/npm-cache && chown -R $SONGCHART_HOST_UID:$SONGCHART_HOST_GID /workspace/vendor /workspace/node_modules /workspace/public/build /workspace/bootstrap/cache /workspace/storage /tmp/composer-cache /tmp/npm-cache"

  local composer_fingerprint npm_fingerprint current
  composer_fingerprint="$(lock_fingerprint "$ROOT/composer.json" "$ROOT/composer.lock")"
  current="$(demo run --rm -T app sh -lc 'cat /workspace/vendor/.songchart-composer-fingerprint 2>/dev/null || true')"
  if [[ "$current" != "$composer_fingerprint" ]] || ! demo run --rm -T app test -f /workspace/vendor/autoload.php; then
    printf '[SongChart demo] Hydrating locked Composer dependencies for fingerprint %s.\n' "$composer_fingerprint"
    demo run --rm app composer install --no-interaction --prefer-dist --no-progress
    demo run --rm -T app sh -lc "printf '%s\\n' '$composer_fingerprint' > /workspace/vendor/.songchart-composer-fingerprint"
  else
    printf '[SongChart demo] Reusing locked Composer dependencies for fingerprint %s.\n' "$composer_fingerprint"
  fi

  npm_fingerprint="$(lock_fingerprint "$ROOT/package.json" "$ROOT/package-lock.json")"
  current="$(demo run --rm -T app sh -lc 'cat /workspace/node_modules/.songchart-npm-fingerprint 2>/dev/null || true')"
  if [[ "$current" != "$npm_fingerprint" ]] || ! demo run --rm -T app test -x /workspace/node_modules/.bin/vite; then
    printf '[SongChart demo] Hydrating locked npm dependencies for fingerprint %s.\n' "$npm_fingerprint"
    demo run --rm app npm ci --no-audit --no-fund
    demo run --rm -T app sh -lc "printf '%s\\n' '$npm_fingerprint' > /workspace/node_modules/.songchart-npm-fingerprint"
  else
    printf '[SongChart demo] Reusing locked npm dependencies for fingerprint %s.\n' "$npm_fingerprint"
  fi
  demo run --rm app npm run build
  demo up -d redis app
  printf '[SongChart demo] READY — '; demo_url
}
focused_test(){
  local no_build=false
  if [[ "${1:-}" == '--no-build' ]]; then
    no_build=true
    shift
  fi
  local focused="${1:-tests/Feature/EntityDetailSystemTest.php}"
  local project="${SONGCHART_FOCUSED_PROJECT:-songchart-focused}"
  local test_command
  (
    set -e
    trap 'docker compose -p "$project" -f "$VERIFY_COMPOSE" down --remove-orphans >/dev/null 2>&1 || true' EXIT
    if [[ "$no_build" != true ]]; then
      docker compose -p "$project" -f "$VERIFY_COMPOSE" build verify
    fi
    if [[ "$focused" == tests/Unit/* || "$focused" == tests/Architecture/* ]]; then
      test_command="php artisan test '$focused'"
    else
      test_command="php scripts/run-database-tests.php postgres --prepare-schema '$focused'"
    fi
    docker compose -p "$project" -f "$VERIFY_COMPOSE" run --rm verify bash -lc "set -euo pipefail; marker=/workspace/vendor/.songchart-dependency-fingerprint; fingerprint=\$(sha256sum composer.json composer.lock | sha256sum | awk '{print \$1}'); current=\$(cat \"\$marker\" 2>/dev/null || true); if [[ ! -f /workspace/vendor/autoload.php || \"\$current\" != \"\$fingerprint\" ]]; then composer install --no-interaction --prefer-dist --no-progress; printf '%s\\n' \"\$fingerprint\" > \"\$marker\"; fi; $test_command"
  )
}
stage_verify(){
  (
    set -e
    trap 'verify_compose down --remove-orphans >/dev/null 2>&1 || true' EXIT
    verify_compose down --remove-orphans
    verify_compose build verify
    verify_compose run --rm verify bash scripts/docker-stage-verify.sh
  )
}
refresh_candidate_authority(){
  printf '[SongChart candidate] Refreshing generated development state.\n'
  dev run --rm app php scripts/project-state.php --write-source
  printf '[SongChart candidate] Refreshing generated source context.\n'
  dev run --rm app php scripts/project-context.php --write-source
  printf '[SongChart candidate] Refreshing compiled repository authority.\n'
  dev run --rm app php scripts/compile-repository-contracts.php --refresh-check
}
reconcile_authority(){
  printf '[SongChart reconcile] Regenerating repository authority from the current exact working tree.\n'
  refresh_candidate_authority
  git -C "$ROOT" diff --check
  printf '[SongChart reconcile] Generated authority diff/status (no automatic commit):\n'
  git -C "$ROOT" status --short -- docs/project/generated || true
  git -C "$ROOT" --no-pager diff -- docs/project/generated || true
}
prepare_candidate_authority(){
  local before after unexpected
  before="$(git -C "$ROOT" status --porcelain --untracked-files=all)"
  [[ -z "$before" ]] || die 'Candidate --prepare requires a clean working tree. Commit or restore source changes first.'

  refresh_candidate_authority
  git -C "$ROOT" diff --check

  after="$(git -C "$ROOT" status --porcelain --untracked-files=all)"
  [[ -n "$after" ]] || { printf '[SongChart candidate] Generated repository authority is already current.\n'; return; }

  unexpected="$(printf '%s\n' "$after" | grep -vE '^.. docs/project/generated(/|$)' || true)"
  if [[ -n "$unexpected" ]]; then
    printf '%s\n' '[SongChart candidate] Preparation changed files outside docs/project/generated; refusing automatic commit.' >&2
    printf '%s\n' "$unexpected" >&2
    exit 1
  fi

  git -C "$ROOT" add -- docs/project/generated
  if git -C "$ROOT" diff --cached --quiet -- docs/project/generated; then
    printf '[SongChart candidate] No generated repository authority changes to commit.\n'
    return
  fi

  git -C "$ROOT" commit -m 'chore: refresh generated repository authority'
  printf '[SongChart candidate] Generated repository authority committed.\n'
}
help(){ cat <<'EOF'
SongChart Linux-first development and operations CLI
  ./songchart ai status
  ./songchart ai doctor
  ./songchart impact [--diff|--verify] [--json] <planned-paths...>
  ./songchart reconcile
  ./songchart audit
  ./songchart dev setup|ready|up|down|status|logs|shell|url
  ./songchart dev url
  ./songchart dev test [--no-build] [test-path]
  ./songchart dev db status|backup|restore [dump-path]
  ./songchart demo setup|up|down|status|logs|url
  ./songchart demo url
  ./songchart prod configure|install|doctor|build|up|down|status
  ./songchart artisan|composer|npm <args...>
  ./songchart context [args...]
  ./songchart candidate [--prepare]
  ./songchart close
  ./songchart test
  ./songchart verify [--no-build] [--keep-services]

AI/workflow convergence:
  ./songchart impact <paths...>     resolve planned authorities, reverse consumers and focused checks
  ./songchart impact --diff        resolve actual stage/working-tree impact after implementation
  ./songchart impact --verify      execute the exact focused checks resolved from the current diff
  ./songchart reconcile            regenerate generated authority and show the resulting diff without committing
  ./songchart audit                collect all quality/static/governance failures without fail-fast

Development/live test:
  ./songchart dev ready     ensure the persistent development runtime is usable; bootstrap automatically when missing
  ./songchart dev setup     bootstrap only when local development configuration is missing; otherwise delegate to ready
  ./songchart dev url       print the governed development URL for local/Codespaces
  ./songchart demo setup    prepare production-like public demo on port 8001 using development PostgreSQL data
  ./songchart demo up       start demo app and ensure the single shared development queue worker authority
  ./songchart demo url      print the governed demo URL for local/Codespaces

Production operations:
  ./songchart prod configure   create/update gitignored production configuration
  ./songchart prod install     build the immutable artifact, migrate and start the selected topology
  ./songchart prod doctor      validate environment, Compose and runtime connectivity
  ./songchart prod status      show production process and Horizon status
  Production supports bundled or external PostgreSQL/Redis; external services are recommended for production isolation.

AI session:
  ./songchart ai status     print current stage, Git, context and verification status
  ./songchart ai doctor     produce the secret-redacted diagnostic bundle through scripts/ai-doctor.sh

Focused verification:
  ./songchart dev test <path>              build/reuse Docker cache, then run isolated focused lane
  ./songchart dev test --no-build <path>   rerun focused lane with the existing verify image

Closure:
  ./songchart candidate             read-only verification of an already committed exact tree
  ./songchart candidate --prepare   refresh/commit generated authority, then candidate-stage verification
  ./songchart close                 refresh/commit generated authority, then run canonical closure; canonical owns stage verification exactly once

Data resilience:
  ./songchart dev db status
  ./songchart dev db backup
  ./songchart dev db restore [dump-path]
  Database dumps are stored under .songchart-db-backups by default; .songchart-backups remains reserved for source/file overwrite recovery artifacts.

Stable projects: songchart-dev / songchart-demo / songchart-verify / configurable production instance
EOF
}
cmd="${1:-help}"; shift || true
case "$cmd" in
 help|--help|-h) help ;;
 ai)
  sub="${1:-status}"; shift || true
  case "$sub" in
   status) exec bash "$ROOT/scripts/ai-status.sh" "$@" ;;
   doctor) exec bash "$ROOT/scripts/ai-doctor.sh" "$@" ;;
   *) die 'Usage: ./songchart ai [status|doctor]' ;;
  esac ;;
 impact)
  require_docker; ensure_dev_config
  if [[ "${1:-}" == '--verify' ]]; then
    shift
    [[ $# -eq 0 ]] || die 'Usage: ./songchart impact --verify'
    exec bash "$ROOT/scripts/run-impact-verification.sh"
  fi
  dev_exec_or_run php scripts/resolve-repository-impact.php "$@" ;;
 reconcile) require_docker; ensure_dev_config; [[ $# -eq 0 ]] || die 'Usage: ./songchart reconcile'; reconcile_authority ;;
 audit) require_docker; ensure_dev_config; [[ $# -eq 0 ]] || die 'Usage: ./songchart audit'; dev_exec_or_run php scripts/run-workflow-audit.php ;;
 dev)
  sub="${1:-}"; shift || true; require_docker
  case "$sub" in
   setup) exec bash "$ROOT/scripts/setup-docker-dev.sh" "$@" ;;
   ready)
    if [[ ! -f "$ROOT/.env.docker" ]]; then
      printf '[SongChart dev] Development configuration is missing; bootstrapping before ready.\n'
      exec bash "$ROOT/scripts/setup-docker-dev.sh"
    fi
    ensure_dev_config
    printf '[SongChart dev] Starting development services.\n'
    repair_dev_runtime_ownership
    ensure_dev_dependencies
    dev_up
    repair_dev_runtime_ownership
    dev_db_assert_identity
    printf '[SongChart dev] Clearing stale compiled views.\n'
    dev_exec_or_run php artisan view:clear
    printf '[SongChart dev] Applying pending development migrations.\n'
    dev_exec_or_run php artisan migrate --force
    ensure_local_admin
    printf '[SongChart dev] Development environment is ready.\n'
    dev ps
    printf '\nLive development: '; dev_url ;;
   up) ensure_dev_config; dev_up; dev_db_assert_identity; dev ps; printf '\nLive development: '; dev_url ;;
   down) dev down --remove-orphans ;;
   status) ensure_dev_config; dev ps; printf '\n'; dev_exec_or_run php artisan development:database-status ;;
   logs) ensure_dev_config; dev logs --follow --tail 200 "$@" ;;
   shell) ensure_dev_config; if dev_app_running; then exec docker compose -p "$DEV_PROJECT" -f "$DEV_COMPOSE" ${CODESPACES:+-f "$CODESPACES_COMPOSE"} exec app bash; else dev run --rm app bash; fi ;;
   url) ensure_dev_config; dev_url ;;
   test) focused_test "$@" ;;
   db)
    action="${1:-}"; shift || true
    case "$action" in
     status) ensure_dev_config; dev_exec_or_run php artisan development:database-status "$@" ;;
     backup) dev_db_backup ;;
     restore) dev_db_restore "${1:-}" ;;
     *) die 'Usage: ./songchart dev db [status|backup|restore [dump-path]]' ;;
    esac ;;
   *) die 'Usage: ./songchart dev [setup|ready|up|down|status|logs|shell|url|test|db]' ;;
  esac ;;
 demo)
  sub="${1:-status}"; shift || true; require_docker
  case "$sub" in
   setup) setup_demo ;;
   up) ensure_dev_config; ensure_demo_config; printf '[SongChart demo] Ensuring single shared development queue worker authority is running.\n'; dev up -d postgres redis app queue; demo up -d redis app; demo ps; printf '\nLive demo: '; demo_url ;;
   down) demo down --remove-orphans ;;
   status) ensure_demo_config; demo ps ;;
   logs) ensure_demo_config; demo logs --follow --tail 200 "$@" ;;
   url) ensure_demo_config; demo_url ;;
   *) die 'Usage: ./songchart demo [setup|up|down|status|logs|url]' ;;
  esac ;;
 prod) exec bash "$ROOT/scripts/production/manage.sh" "$@" ;;
 artisan) require_docker; ensure_dev_config; [[ $# -gt 0 ]] || die 'Usage: ./songchart artisan <args...>'; dev_exec_or_run php artisan "$@" ;;
 composer) require_docker; ensure_dev_config; [[ $# -gt 0 ]] || die 'Usage: ./songchart composer <args...>'; dev_exec_or_run composer "$@" ;;
 npm) require_docker; ensure_dev_config; [[ $# -gt 0 ]] || die 'Usage: ./songchart npm <args...>'; dev_exec_or_run npm "$@" ;;
 context) require_docker; ensure_dev_config; args=(); for a in "$@"; do [[ "$a" == '--refresh-source' ]] && args+=('--write-source') || args+=("$a"); done; dev run --rm app php scripts/project-context.php "${args[@]}" ;;
 candidate)
  require_docker; ensure_dev_config
  prepare=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --prepare) prepare=true ;;
      *) die "Unknown candidate option: $1" ;;
    esac
    shift
  done

  if [[ "$prepare" == true ]]; then
    prepare_candidate_authority
  else
    git -C "$ROOT" diff --check
  fi

  if [[ -n "$(git -C "$ROOT" status --porcelain --untracked-files=all)" ]]; then
    die 'Candidate verification requires a clean committed working tree.'
  fi

  printf '[SongChart candidate] Running candidate verification.\n'
  stage_verify
  printf '[SongChart candidate] PASSED.\n' ;;
 close)
  require_docker; ensure_dev_config
  prepare_candidate_authority
  [[ -z "$(git -C "$ROOT" status --porcelain --untracked-files=all)" ]] || die 'Closure requires a clean committed working tree.'
  printf '[SongChart close] Running canonical verification; canonical owns the stage lane exactly once.\n'
  verify_compose down --remove-orphans
  verify_compose build verify
  cleanup(){ verify_compose down --remove-orphans >/dev/null 2>&1 || true; }
  trap cleanup EXIT
  verify_compose run --rm verify
  printf '[SongChart close] PASSED.\n' ;;
 test) require_docker; stage_verify; printf '[SongChart stage] PASSED.\n' ;;
 verify)
  require_docker; no_build=false; keep=false
  while [[ $# -gt 0 ]]; do case "$1" in --no-build) no_build=true;; --keep-services) keep=true;; *) die "Unknown verify option: $1";; esac; shift; done
  cleanup(){ [[ "$keep" == true ]] || verify_compose down --remove-orphans >/dev/null 2>&1 || true; }; trap cleanup EXIT
  verify_compose down --remove-orphans; [[ "$no_build" == true ]] || verify_compose build verify; verify_compose run --rm verify; printf '[SongChart verify] PASSED.\n' ;;
 *) help; die "Unknown command: $cmd" ;;
esac
