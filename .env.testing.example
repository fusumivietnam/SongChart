APP_ENV=testing
APP_DEBUG=true
DB_CONNECTION=pgsql
TEST_PGSQL_HOST=127.0.0.1
TEST_PGSQL_PORT=5432
# User-configurable. Keep it different from the development database and retain the *_test suffix for fail-closed bootstrap safety.
TEST_PGSQL_DATABASE=songchart_test
TEST_PGSQL_USERNAME=songchart_admin
TEST_PGSQL_PASSWORD=
SONGCHART_ADMIN_2FA_MODE=required
